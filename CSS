:root { --main: #0f766e; --dark: #134e4a; --accent: #f59e0b; --bg: #f0f7f6;
        --card: #ffffff; --text: #1f2937; --danger: #dc2626; }
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: "Segoe UI", Arial, sans-serif; background: var(--bg);
       color: var(--text); line-height: 1.5; }
.hidden { display: none !important; }

.topbar { background: var(--dark); color: #fff; padding: 12px 24px; display: flex;
          align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
nav button { background: none; border: 0; color: #fff; padding: 8px 14px; margin: 0 2px;
             border-radius: 20px; font-size: 1rem; cursor: pointer; }
nav button:hover, nav button.active { background: var(--accent); color: #111; }
.who { font-size: .85rem; background: #ffffff22; padding: 4px 12px; border-radius: 14px; }

main { max-width: 1080px; margin: auto; padding: 24px 16px; }
h2 { color: var(--dark); margin-bottom: 14px; }
h3 { color: var(--dark); margin: 20px 0 8px; }
.banner { background: linear-gradient(120deg, var(--main), #14b8a6); color: #fff;
          padding: 30px; border-radius: 14px; text-align: center; }
.banner h2 { color: #fff; margin-bottom: 6px; }
.clock { font-size: 1.5rem; font-weight: 700; margin-top: 10px; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
         gap: 16px; margin-top: 20px; }
.stat { background: var(--card); padding: 18px; border-radius: 12px; text-align: center;
        box-shadow: 0 2px 8px #0001; }
.stat b { display: block; font-size: 2rem; color: var(--main); }

.toolbar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; }
input, select, textarea { padding: 10px 12px; border: 1px solid #b6c2c1; border-radius: 8px;
                          font: inherit; flex: 1; min-width: 170px; }
.note { color: #5b6b6a; margin-bottom: 10px; }

.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
.card { background: var(--card); padding: 18px; border-radius: 12px; border-top: 5px solid var(--main);
        box-shadow: 0 2px 8px #0001; }
.card h3 { margin: 0 0 4px; }
.tag { display: inline-block; background: #ccfbf1; color: var(--dark); font-size: .8rem;
       padding: 2px 10px; border-radius: 12px; margin: 8px 4px 8px 0; }
button.btn, .panel button { background: var(--main); color: #fff; border: 0; padding: 8px 16px;
                            border-radius: 8px; cursor: pointer; font: inherit; margin-top: 8px; }
button.join { background: var(--accent); color: #111; font-weight: 600; }
button.leave { background: var(--danger); }

.panel { background: var(--card); padding: 22px; border-radius: 12px; max-width: 560px;
         box-shadow: 0 2px 8px #0001; display: flex; flex-direction: column; gap: 10px; }
.panel label { display: flex; flex-direction: column; font-weight: 600; gap: 4px; }
small { color: var(--danger); font-weight: 400; min-height: 1.1em; }
.success { color: #15803d; font-weight: 600; }

.table-wrap { overflow-x: auto; background: var(--card); border-radius: 12px;
              box-shadow: 0 2px 8px #0001; }
table { width: 100%; border-collapse: collapse; }
th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid #e5e7eb; }
th { background: var(--main); color: #fff; }
tbody tr:hover { background: #ecfdf5; }

.event { background: var(--card); border-left: 5px solid var(--accent); padding: 14px;
         border-radius: 8px; margin-top: 12px; box-shadow: 0 2px 8px #0001; }
.event h4 { color: var(--dark); }

.modal { position: fixed; inset: 0; background: #0007; display: flex;
         align-items: center; justify-content: center; padding: 16px; }
.modal-box { background: #fff; border-radius: 12px; padding: 22px; width: 100%; max-width: 420px; }
.toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
         background: var(--dark); color: #fff; padding: 10px 20px; border-radius: 20px; }
footer { text-align: center; padding: 18px; color: #5b6b6a; font-size: .9rem; }

@media (max-width: 600px) {
  .topbar { flex-direction: column; text-align: center; }
  nav button { padding: 6px 10px; }
  .banner { padding: 20px; }
  .grid { grid-template-columns: 1fr; }
}
